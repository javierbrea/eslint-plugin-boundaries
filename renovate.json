{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>javierbrea/renovate-config"
  ],
  "constraints": {
    "pnpm": "9.4.0",
    "node": "22.4.0"
  },
  "baseBranchPatterns": [
    "release"
  ],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchFileNames": [
        "**/package.json"
      ],
      "matchPackageNames": [
        "chalk"
      ],
      "allowedVersions": "<5.0.0"
    },
    {
      "description": "eslint-import-resolver-node 0.3.10 and later use resolve 2.x, which no longer resolves relative imports when the directory of the linted file does not exist",
      "matchFileNames": [
        "**/package.json"
      ],
      "matchPackageNames": [
        "eslint-import-resolver-node"
      ],
      "allowedVersions": "<0.3.10"
    }
  ]
}
