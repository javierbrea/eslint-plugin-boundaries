{
  "name": "@boundaries/workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Monorepo for @boundaries packages",
  "author": "Javier Brea",
  "packageManager": "pnpm@10.34.5",
  "license": "MIT",
  "scripts": {
    "nx": "nx",
    "eslint": "eslint",
    "lint": "eslint *.* .vscode scripts --no-warn-ignored",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "check:all": "nx run-many -t check:all --all",
    "check:spell": "cspell --quiet *.* .vscode/*.* .husky/*.* .github/**/*.* docs/**/*.* scripts/**/*.*"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-typescript": "7.29.7",
    "@stryker-mutator/api": "9.6.0",
    "@stryker-mutator/core": "9.6.0",
    "@stryker-mutator/jest-runner": "9.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@typescript-eslint/parser": "8.69.0",
    "cross-env": "10.1.0",
    "cspell": "9.8.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "jest": "30.5.1",
    "lint-staged": "16.4.0",
    "nx": "22.7.7",
    "serve": "14.2.6",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md}": "node scripts/lint-staged-file.js",
    "*.*": "cspell --no-must-find-files"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
