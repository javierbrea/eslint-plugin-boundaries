{
  "name": "@boundaries/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens and self-hosted fonts of JS Boundaries, shared by the website and the hosts of the playground",
  "author": "Javier Brea",
  "license": "(MIT AND OFL-1.1)",
  "repository": {
    "type": "git",
    "url": "https://github.com/javierbrea/eslint-plugin-boundaries.git",
    "directory": "packages/design-tokens"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "eslint": "eslint",
    "check:all": "echo 'All checks passed'",
    "check:spell": "cspell --quiet .",
    "check:types": "tsc --noEmit",
    "lint": "node scripts/sync-fonts.mjs --check && eslint .",
    "lint:fix": "eslint . --fix",
    "sync:fonts": "node scripts/sync-fonts.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "typescript": "5.9.3"
  }
}
