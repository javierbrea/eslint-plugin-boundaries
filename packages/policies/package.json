{
  "name": "@boundaries/policies",
  "version": "1.0.0",
  "description": "Evaluation of the dependency policies and messages of @boundaries tools",
  "keywords": [
    "boundaries",
    "policies",
    "dependencies",
    "architecture"
  ],
  "author": "Javier Brea",
  "license": "MIT",
  "homepage": "https://github.com/javierbrea/eslint-plugin-boundaries/tree/master/packages/policies#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/javierbrea/eslint-plugin-boundaries.git",
    "directory": "packages/policies"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.mjs",
        "require": "./dist/index.browser.js"
      },
      "node": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "eslint": "eslint",
    "build": "tsup --config tsup.config.js",
    "check:all": "echo 'All checks passed'",
    "check:spell": "cspell --quiet .",
    "check:types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "serve:mutation:report": "serve --config ./serve.test-mutation-report.json",
    "serve:unit:report": "serve --config ./serve.test-unit-report.json",
    "test": "pnpm test:unit",
    "test:unit": "jest",
    "test:e2e": "node --test test/e2e/builds.spec.mjs",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@boundaries/config": "workspace:*",
    "@boundaries/elements": "workspace:*",
    "handlebars": "4.7.10"
  },
  "engines": {
    "node": ">=18.18"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
