{
  "compilerOptions": {
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "dist",
    "declaration": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "forceConsistentCasingInFileNames": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "types": ["jest"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*"]
}
