{
  "name": "website",
  "version": "7.4.3",
  "private": true,
  "exports": {
    "./playwright": {
      "types": "./dist-playwright/playwright.d.mts",
      "import": "./dist-playwright/playwright.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "eslint": "eslint",
    "build": "docusaurus build",
    "build:playwright": "tsup --config tsup.playwright.config.js && node ../../scripts/check-bundle-imports.js dist-playwright --allow @playwright/test --allow @boundaries/playground/playwright",
    "check:all": "echo 'All checks passed'",
    "check:spell": "cspell --quiet .",
    "check:types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docusaurus": "docusaurus",
    "start": "cross-env NODE_ENV=development docusaurus start",
    "serve": "docusaurus serve",
    "screenshots": "playwright install chromium && node scripts/screenshots.mjs",
    "social-card": "playwright install chromium && node scripts/social-card.mjs",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "test:unit": "jest --passWithNoTests",
    "version": "docusaurus docs:version"
  },
  "dependencies": {
    "@boundaries/design-tokens": "workspace:*",
    "@boundaries/playground": "workspace:*",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mdx-js/react": "3.1.1",
    "@mui/material": "9.5.0",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.3.0",
    "baseline-browser-mapping": "2.11.35",
    "eslint-plugin-boundaries": "workspace:@boundaries/eslint-plugin@*",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
