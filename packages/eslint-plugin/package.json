{
  "name": "@boundaries/eslint-plugin",
  "version": "7.4.0",
  "description": "Eslint plugin checking architecture boundaries between elements",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "plugin",
    "architecture",
    "boundaries",
    "dependencies",
    "elements",
    "files",
    "modules",
    "analysis",
    "hierarchy",
    "import",
    "dependency"
  ],
  "author": "Javier Brea",
  "license": "MIT",
  "homepage": "https://www.jsboundaries.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/javierbrea/eslint-plugin-boundaries.git",
    "directory": "packages/eslint-plugin"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/Config/Config.js",
    "./recommended": "./dist/Config/Recommended.js",
    "./strict": "./dist/Config/Strict.js"
  },
  "typesVersions": {
    "*": {
      "config": [
        "dist/Config/Config.d.ts"
      ],
      "recommended": [
        "dist/Config/Recommended.d.ts"
      ],
      "strict": [
        "dist/Config/Strict.d.ts"
      ]
    }
  },
  "scripts": {
    "eslint": "eslint",
    "build": "pnpm build:tsc && pnpm copy:readme",
    "build:tsc": "tsc --project ./tsconfig.code.json",
    "copy:readme": "cross-env node ./scripts/copy-readme.js",
    "check:all": "echo 'All checks passed'",
    "check:spell": "cspell --quiet .",
    "check:types": "pnpm check:types:code && pnpm check:types:test",
    "check:types:code": "tsc --noEmit --project ./tsconfig.code.json",
    "check:types:test": "tsc --noEmit --project ./tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "serve:unit:report": "serve --config ./serve.test-unit-report.json",
    "test": "jest",
    "test:unit": "pnpm test",
    "test:unit:debug": "ESLINT_PLUGIN_BOUNDARIES_DEBUG=1 pnpm test:unit"
  },
  "peerDependencies": {
    "eslint": ">=6.0.0"
  },
  "dependencies": {
    "@boundaries/config": "workspace:*",
    "@boundaries/elements": "workspace:*",
    "@boundaries/policies": "workspace:*",
    "chalk": "4.1.2",
    "eslint-import-resolver-node": "0.3.9",
    "eslint-module-utils": "2.14.0"
  },
  "engines": {
    "node": ">=18.18"
  },
  "devDependencies": {
    "@types/estree": "1.0.9",
    "eslint": "9.39.5",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint-plugin-local-rules": "3.0.2"
  }
}
