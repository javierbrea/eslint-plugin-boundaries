{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cspell-config",
  "projectType": "library",
  "tags": [
    "type:node:config"
  ],
  "implicitDependencies": [
    "eslint-config"
  ],
  "targets": {
    "lint": {
      "cache": true,
      "inputs": [
        { "dependentTasksOutputFiles": "**/*", "transitive": true },
        "default"
      ],
      "dependsOn": [
        {
          "target": "eslint:config",
          "projects": ["eslint-config"]
        }
      ]
    },
    "cspell:config": {
      "cache": true,
      "inputs": ["default"],
      "outputs": [
        "{projectRoot}/**/*"
      ]
    }
  }
}
